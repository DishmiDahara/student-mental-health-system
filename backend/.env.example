# ==============================================================================
# MindSpace Backend Environment Variables Example
# Copy this file to .env and configure with your credentials.
# NEVER commit your real secrets (.env) to version control.
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/mentalhealth

# JWT Authentication Secret Key (Use a strong, secure random string)
JWT_SECRET=your_jwt_secret_key_here

# AI Strategy Configuration
# Primary AI Provider: 'gemini'
AI_PROVIDER=gemini

# Google Gemini API Key
# Obtain an official API key from Google AI Studio: https://aistudio.google.com/
# Keep this strictly server-side. Never expose it to client-side bundles or repository.
GEMINI_API_KEY=your_actual_key

# Google Gemini Model Name
# Supported models: 'gemini-3.8-flash', 'gemini-2.0-flash' (GA default), 'gemini-1.5-flash'
GEMINI_MODEL=gemini-3.8-flash
