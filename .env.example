# ==============================================================================
# MindSpace Platform Environment Variables Example
# Copy this file to .env or backend/.env and configure with your credentials.
# NEVER commit your real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/mentalhealth
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI Integration (Server-Side Only)
# Obtain your key from Google AI Studio (https://aistudio.google.com/)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_actual_key
GEMINI_MODEL=gemini-3.8-flash
